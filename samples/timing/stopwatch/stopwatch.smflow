{
  "formatVersion": 5,
  "name": "stopwatch",
  "targets": [
    "simulator"
  ],
  "tasks": [
    {
      "name": "main",
      "periodMs": 100
    }
  ],
  "nodes": [
    {
      "id": "startStop",
      "type": "digital-input",
      "name": "StartStop"
    },
    {
      "id": "clear",
      "type": "digital-input",
      "name": "Clear"
    },
    {
      "id": "runLatch",
      "type": "toggle",
      "comment": "A toggle (T flip-flop). Q flips on each rising edge of CLK (StartStop), so one press runs, the next stops. R (Clear) forces Q off. This is how a momentary button becomes a sticky run/stop state that survives between scans."
    },
    {
      "id": "writeRunning",
      "type": "variable-write",
      "name": "Running"
    },
    {
      "id": "tick",
      "type": "variable-read",
      "name": "OneTenth"
    },
    {
      "id": "zero",
      "type": "variable-read",
      "name": "Zero"
    },
    {
      "id": "elapsedRead",
      "type": "variable-read",
      "name": "ElapsedTenths"
    },
    {
      "id": "increment",
      "type": "select",
      "properties": {
        "type": "int32"
      },
      "comment": "select is a multiplexer, not a branch: out = cond ? whenTrue : whenFalse. Here out = running ? OneTenth(1) : Zero(0). Rather than conditionally executing an 'add', the graph always adds, but the amount is 1 or 0. Same work every scan — that is the branch-free style these flows favor."
    },
    {
      "id": "accumulate",
      "type": "variable-update",
      "name": "ElapsedTenths",
      "properties": {
        "operation": "add"
      },
      "comment": "variable-update is a read-modify-write of a shared variable in one node: ElapsedTenths += value. At a 100 ms scan, adding 1 while running makes ElapsedTenths count tenths of a second. Two updates target ElapsedTenths this scan (this add and the subtract below); they apply in execution order, not simultaneously."
    },
    {
      "id": "clearAmount",
      "type": "select",
      "properties": {
        "type": "int32"
      }
    },
    {
      "id": "zeroOut",
      "type": "variable-update",
      "name": "ElapsedTenths",
      "properties": {
        "operation": "subtract"
      },
      "comment": "The reset trick. clearAmount picks the current ElapsedTenths when Clear is held, else 0, and this node subtracts it. So pressing Clear drives the total to exactly zero without any 'set to a constant' node — again branch-free."
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "A stopwatch counting tenths of a second. StartStop toggles a run latch; while running, each 100 ms scan adds 1 to ElapsedTenths. Clear resets it by subtracting the current total. The thing to notice: there is no 'if' node anywhere. Both the add amount and the subtract amount are chosen with a select (mux), so every scan does the same operations and takes the same time — important for deterministic control."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "startStop",
        "port": "value"
      },
      "to": {
        "node": "runLatch",
        "port": "CLK"
      }
    },
    {
      "from": {
        "node": "clear",
        "port": "value"
      },
      "to": {
        "node": "runLatch",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "runLatch",
        "port": "Q"
      },
      "to": {
        "node": "writeRunning",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "runLatch",
        "port": "Q"
      },
      "to": {
        "node": "increment",
        "port": "cond"
      }
    },
    {
      "from": {
        "node": "tick",
        "port": "value"
      },
      "to": {
        "node": "increment",
        "port": "whenTrue"
      }
    },
    {
      "from": {
        "node": "zero",
        "port": "value"
      },
      "to": {
        "node": "increment",
        "port": "whenFalse"
      }
    },
    {
      "from": {
        "node": "increment",
        "port": "out"
      },
      "to": {
        "node": "accumulate",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "clear",
        "port": "value"
      },
      "to": {
        "node": "clearAmount",
        "port": "cond"
      }
    },
    {
      "from": {
        "node": "elapsedRead",
        "port": "value"
      },
      "to": {
        "node": "clearAmount",
        "port": "whenTrue"
      }
    },
    {
      "from": {
        "node": "zero",
        "port": "value"
      },
      "to": {
        "node": "clearAmount",
        "port": "whenFalse"
      }
    },
    {
      "from": {
        "node": "clearAmount",
        "port": "out"
      },
      "to": {
        "node": "zeroOut",
        "port": "value"
      }
    }
  ],
  "variables": [
    {
      "name": "ElapsedTenths",
      "type": "int32",
      "initial": "0"
    },
    {
      "name": "Running",
      "type": "bool",
      "initial": "false"
    },
    {
      "name": "OneTenth",
      "type": "int32",
      "initial": "1"
    },
    {
      "name": "Zero",
      "type": "int32",
      "initial": "0"
    }
  ],
  "hardware": [
    {
      "logical": "StartStop",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Clear",
      "direction": "input",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 560
      },
      "startStop": {
        "x": 40,
        "y": 40
      },
      "clear": {
        "x": 40,
        "y": 160
      },
      "runLatch": {
        "x": 240,
        "y": 60
      },
      "writeRunning": {
        "x": 440,
        "y": 40
      },
      "tick": {
        "x": 440,
        "y": 260
      },
      "zero": {
        "x": 440,
        "y": 340
      },
      "elapsedRead": {
        "x": 440,
        "y": 440
      },
      "increment": {
        "x": 660,
        "y": 180
      },
      "accumulate": {
        "x": 880,
        "y": 180
      },
      "clearAmount": {
        "x": 660,
        "y": 400
      },
      "zeroOut": {
        "x": 880,
        "y": 400
      }
    }
  }
}
