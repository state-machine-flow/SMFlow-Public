{
  "formatVersion": 6,
  "name": "persistent-counter",
  "target": "atmega328-nano",
  "targets": [
    "atmega2560-mega",
    "atmega328-nano",
    "atmega328-uno",
    "esp32-s3",
    "heltec-lora32-v3",
    "linux-x64",
    "rp2040-pico",
    "simulator"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 500
    }
  ],
  "nodes": [
    {
      "id": "btn",
      "type": "digital-input",
      "name": "Button"
    },
    {
      "id": "read_one",
      "type": "variable-read",
      "name": "One"
    },
    {
      "id": "read_zero",
      "type": "variable-read",
      "name": "Zero"
    },
    {
      "id": "inc",
      "type": "select",
      "properties": {
        "type": "int32"
      }
    },
    {
      "id": "accumulate",
      "type": "variable-update",
      "name": "PressCount",
      "properties": {
        "operation": "add"
      }
    },
    {
      "id": "save",
      "type": "persist-save",
      "properties": {
        "region": "retained"
      }
    },
    {
      "id": "status",
      "type": "persist-status",
      "properties": {
        "region": "retained"
      }
    },
    {
      "id": "restore_edge",
      "type": "rising-edge"
    },
    {
      "id": "or_send",
      "type": "or"
    },
    {
      "id": "read_count",
      "type": "variable-read",
      "name": "PressCount"
    },
    {
      "id": "text",
      "type": "to-text",
      "properties": {
        "decimals": "0",
        "format": "Count: {}\n",
        "type": "int32"
      }
    },
    {
      "id": "console",
      "type": "serial-tx",
      "name": "Console"
    }
  ],
  "connections": [
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "cond"
      }
    },
    {
      "from": {
        "node": "read_one",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "whenTrue"
      }
    },
    {
      "from": {
        "node": "read_zero",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "whenFalse"
      }
    },
    {
      "from": {
        "node": "inc",
        "port": "out"
      },
      "to": {
        "node": "accumulate",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "save",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "status",
        "port": "restored"
      },
      "to": {
        "node": "restore_edge",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "or_send",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "restore_edge",
        "port": "Q"
      },
      "to": {
        "node": "or_send",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "read_count",
        "port": "value"
      },
      "to": {
        "node": "text",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "text",
        "port": "text"
      },
      "to": {
        "node": "console",
        "port": "data"
      }
    },
    {
      "from": {
        "node": "or_send",
        "port": "out"
      },
      "to": {
        "node": "console",
        "port": "send"
      }
    }
  ],
  "variables": [
    {
      "name": "PressCount",
      "type": "int32",
      "initial": "0",
      "persistence": "retained"
    },
    {
      "name": "One",
      "type": "int32",
      "initial": "1"
    },
    {
      "name": "Zero",
      "type": "int32",
      "initial": "0"
    }
  ],
  "hardware": [
    {
      "logical": "Button",
      "direction": "input",
      "type": "bool"
    }
  ],
  "persistence": {
    "retained": {
      "atmega2560-mega": "eeprom0",
      "atmega328-nano": "eeprom0",
      "atmega328-uno": "eeprom0",
      "esp32-s3": "nvs0",
      "heltec-lora32-v3": "nvs0",
      "linux-x64": "file0",
      "rp2040-pico": "flash0",
      "simulator": "sim-store"
    }
  },
  "ui": {
    "nodes": {
      "accumulate": {
        "x": 735.1999999999995,
        "y": 375.1999999999997
      },
      "btn": {
        "x": -20.799999999999827,
        "y": 82.40000000000006
      },
      "console": {
        "x": 962.4,
        "y": 240.80000000000018
      },
      "inc": {
        "x": 467.9999999999994,
        "y": 347.1999999999999
      },
      "or_send": {
        "x": 509.60000000000014,
        "y": 132.0000000000002
      },
      "read_count": {
        "x": 476.79999999999995,
        "y": 24.80000000000058
      },
      "read_one": {
        "x": 58.40000000000009,
        "y": 381.59999999999985
      },
      "read_zero": {
        "x": 56.799999999999955,
        "y": 487.19999999999976
      },
      "restore_edge": {
        "x": 77.6000000000005,
        "y": 235.20000000000027
      },
      "save": {
        "x": 270.4000000000003,
        "y": -68.7999999999995
      },
      "status": {
        "x": -170.39999999999972,
        "y": 219.2000000000004
      },
      "text": {
        "x": 722.3999999999999,
        "y": 33.60000000000057
      }
    }
  }
}
