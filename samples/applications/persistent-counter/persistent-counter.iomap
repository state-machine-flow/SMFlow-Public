{
  "formatVersion": 1,
  "project": "persistent-counter",
  "bindings": {
    "atmega2560-mega": {
      "Button": "D2"
    },
    "atmega328-nano": {
      "Button": "D2"
    },
    "atmega328-uno": {
      "Button": "D2"
    },
    "esp32-s3": {
      "Button": "GPIO0"
    },
    "heltec-lora32-v3": {
      "Button": "GPIO0"
    },
    "linux-x64": {
      "Button": "gpio0"
    },
    "rp2040-pico": {
      "Button": "GP14"
    },
    "simulator": {
      "Button": "virtual.Button"
    }
  },
  "serial": {
    "atmega2560-mega": {
      "Console": {
        "bus": "uart0",
        "baud": 9600,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "atmega328-nano": {
      "Console": {
        "bus": "uart0",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "atmega328-uno": {
      "Console": {
        "bus": "uart0",
        "baud": 9600,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "esp32-s3": {
      "Console": {
        "bus": "uart0",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "heltec-lora32-v3": {
      "Console": {
        "bus": "uart0",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "linux-x64": {
      "Console": {
        "bus": "console",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "rp2040-pico": {
      "Console": {
        "bus": "uart0",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "simulator": {
      "Console": {
        "bus": "virtual.uart0",
        "baud": 9600,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    }
  }
}
