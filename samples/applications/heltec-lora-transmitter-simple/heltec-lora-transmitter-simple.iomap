{
  "formatVersion": 1,
  "project": "lora-press-counter",
  "bindings": {
    "esp32-s3": {
      "Busy": "GPIO1",
      "Button": {
        "pin": "GPIO7",
        "resistor": "pullDown"
      },
      "Done": "GPIO2",
      "Error": "GPIO3",
      "Input1": {
        "pin": "GPIO19",
        "resistor": "pullDown"
      }
    },
    "heltec-lora32-v3": {
      "Button": {
        "pin": "GPIO7",
        "resistor": "pullDown"
      },
      "Input1": {
        "pin": "GPIO19",
        "resistor": "pullDown"
      },
      "Busy": "GPIO35",
      "Done": "GPIO2",
      "Error": "GPIO3"
    }
  },
  "peripherals": {
    "esp32-s3": {
      "Oled": {
        "bus": "i2c1",
        "address": "0x3C",
        "pins": {
          "reset": "GPIO21",
          "power": "GPIO36"
        },
        "config": {
          "powerActiveLow": "true"
        }
      },
      "Radio": {
        "bus": "fspi",
        "pins": {
          "busy": "GPIO4",
          "dio1": "GPIO6",
          "reset": "GPIO5"
        }
      }
    },
    "heltec-lora32-v3": {
      "Oled": {
        "bus": "i2c0",
        "address": "0x3C",
        "pins": {
          "reset": "GPIO21"
        }
      },
      "Radio": {
        "bus": "spi_lora",
        "cs": "GPIO8",
        "pins": {
          "busy": "GPIO13",
          "dio1": "GPIO14",
          "reset": "GPIO12"
        },
        "config": {
          "frequencyHz": "915125000",
          "spreadingFactor": "7",
          "bandwidthKhz": "125",
          "codingRate": "5",
          "syncWord": "private",
          "txPowerDbm": "14",
          "tcxoVoltageMv": "1800",
          "preambleSymbols": "8"
        }
      }
    }
  }
}
