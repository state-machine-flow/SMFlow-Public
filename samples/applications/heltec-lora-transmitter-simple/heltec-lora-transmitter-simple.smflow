{
  "formatVersion": 4,
  "name": "heltec-lora-transmitter-simple",
  "target": "heltec-lora32-v3",
  "targets": [
    "esp32-s3",
    "heltec-lora32-v3"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "btn",
      "type": "digital-input",
      "name": "Button"
    },
    {
      "id": "cnt",
      "type": "counter",
      "properties": {
        "presetCount": "1000"
      }
    },
    {
      "id": "builder",
      "type": "create-payload",
      "properties": {
        "schema": "pressCount:int32:be"
      },
      "comment": "Packs named inputs into the raw bytes a LoRa packet carries, using the same 'field:type:endian' schema the receiver unpacks with. The in_pressCount port feeds the one field. This schema and the receiver's must stay identical - change one, change both."
    },
    {
      "id": "tx",
      "type": "sx1262-tx",
      "name": "Radio",
      "comment": "Transmits the current payload when 'trigger' fires. A LoRa send is not instant - it takes tens of milliseconds - so the radio reports progress on separate ports: 'busy' is high during the air time, 'done' pulses when the packet is out, 'error' on failure. Fire-and-watch: you kick off the send, then react to busy/done/error, never assuming it completed within this scan."
    },
    {
      "id": "led",
      "type": "digital-output",
      "name": "Busy"
    },
    {
      "id": "n1",
      "type": "digital-input",
      "name": "Input1"
    },
    {
      "id": "n2",
      "type": "digital-output",
      "name": "Done"
    },
    {
      "id": "n3",
      "type": "digital-output",
      "name": "Error"
    },
    {
      "id": "n5",
      "type": "counter",
      "properties": {
        "presetCount": "10"
      }
    },
    {
      "id": "fmt",
      "type": "to-text",
      "name": "CountText",
      "properties": {
        "format": "Sent: {}",
        "type": "int32"
      }
    },
    {
      "id": "oled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "0"
      }
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "The transmitting half of the LoRa link (pair with heltec-lora-receiver-simple). A button bumps a press counter; that value is packed into a binary payload and sent over the SX1262 radio. Because a radio send spans many scans, it is fire-and-watch: 'trigger' starts it and busy/done/error report how it went - wired here to a Busy LED, Done/Error outputs, and a completed-send counter. The OLED shows how many presses have been sent."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "cnt",
        "port": "CU"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "tx",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "cnt",
        "port": "CV"
      },
      "to": {
        "node": "builder",
        "port": "in_pressCount"
      }
    },
    {
      "from": {
        "node": "builder",
        "port": "payload"
      },
      "to": {
        "node": "tx",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "busy"
      },
      "to": {
        "node": "led",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "cnt",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "done"
      },
      "to": {
        "node": "n2",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "error"
      },
      "to": {
        "node": "n3",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "done"
      },
      "to": {
        "node": "n5",
        "port": "CU"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n5",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "cnt",
        "port": "CV"
      },
      "to": {
        "node": "fmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "fmt",
        "port": "text"
      },
      "to": {
        "node": "oled",
        "port": "text"
      }
    }
  ],
  "hardware": [
    {
      "logical": "Button",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Busy",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Input1",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Done",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Error",
      "direction": "output",
      "type": "bool"
    }
  ],
  "peripherals": [
    {
      "name": "Radio",
      "type": "semtech:sx1262"
    },
    {
      "name": "Oled",
      "type": "solomon:ssd1306"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 520
      },
      "btn": {
        "x": 40,
        "y": 80
      },
      "builder": {
        "x": 491.19999999999993,
        "y": 221.6000000000001
      },
      "cnt": {
        "x": 257.6,
        "y": 253.59999999999997
      },
      "fmt": {
        "x": 1038.0824000000002,
        "y": 475.1935999999999
      },
      "led": {
        "x": 1028.7999999999997,
        "y": 15.200000000000003
      },
      "n1": {
        "x": 26.799999999999983,
        "y": 384.8
      },
      "n2": {
        "x": 1026.8,
        "y": 120.80000000000004
      },
      "n3": {
        "x": 1024.3159999999998,
        "y": 360.04479999999995
      },
      "n5": {
        "x": 1034.2368000000001,
        "y": 227.228
      },
      "oled": {
        "x": 1312.8008000000002,
        "y": 448.48240000000004
      },
      "tx": {
        "x": 751.1999999999998,
        "y": 135.2
      }
    }
  }
}
