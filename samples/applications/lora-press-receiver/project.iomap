{
  "formatVersion": 1,
  "project": "lora-press-receiver",
  "bindings": {},
  "serial": {
    "linux-arm64": {
      "Console": {
        "bus": "console",
        "baud": 115200,
        "txCapacity": 128,
        "txBufferOctets": 256
      },
      "LoRa": {
        "bus": "serial0",
        "baud": 9600,
        "txCapacity": 128,
        "txBufferOctets": 256
      }
    },
    "linux-x64": {
      "Console": {
        "bus": "console",
        "baud": 115200,
        "txCapacity": 128,
        "txBufferOctets": 256
      },
      "LoRa": {
        "bus": "ttyUSB0",
        "baud": 9600,
        "txCapacity": 128,
        "txBufferOctets": 256
      }
    }
  }
}
