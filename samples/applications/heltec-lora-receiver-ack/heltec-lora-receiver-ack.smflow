{
  "formatVersion": 5,
  "name": "heltec-lora-receiver-ack",
  "target": "heltec-lora32-v3",
  "targets": [
    "heltec-lora32-v3"
  ],
  "tasks": [
    {
      "name": "main",
      "periodMs": 10
    },
    {
      "name": "task2",
      "periodMs": 0,
      "kind": "init"
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "sx1262-rx",
      "name": "lora"
    },
    {
      "id": "n3",
      "type": "unpack-payload",
      "properties": {
        "schema": "pressCount:int32:be"
      }
    },
    {
      "id": "en",
      "type": "variable-read",
      "name": "RadioEnable"
    },
    {
      "id": "fmt",
      "type": "to-text",
      "properties": {
        "format": "Count: {}",
        "type": "int32"
      }
    },
    {
      "id": "n6",
      "type": "to-text",
      "properties": {
        "format": "RSSI: {0.00}",
        "type": "float32"
      }
    },
    {
      "id": "n8",
      "type": "ssd1306-text",
      "name": "oled",
      "task": "task2",
      "properties": {
        "text": "LoRa Rx"
      }
    },
    {
      "id": "n9",
      "type": "ssd1306-text",
      "name": "oled",
      "properties": {
        "line": "1"
      }
    },
    {
      "id": "n10",
      "type": "ssd1306-text",
      "name": "oled",
      "properties": {
        "line": "2"
      }
    },
    {
      "id": "ackbuild",
      "type": "create-payload",
      "properties": {
        "schema": "ackCount:int32:be"
      },
      "comment": "Builds the return packet: the pressCount just received is echoed back as ackCount. This is its own schema, separate from the inbound one, and must match the transmitter's ack-unpack schema. Echoing the value lets the sender confirm its exact packet was heard."
    },
    {
      "id": "acktx",
      "type": "sx1262-tx",
      "name": "lora",
      "comment": "Transmits the ack on the SAME radio n1 receives on - both nodes name the one 'lora' peripheral. The SX1262 is half-duplex (it cannot receive and transmit at the same instant), so the ack is fired on n1's 'available' (just after a packet has been taken in), not concurrently with receiving."
    },
    {
      "id": "ackcnt",
      "type": "counter",
      "properties": {
        "presetCount": "1000"
      }
    },
    {
      "id": "ackfmt",
      "type": "to-text",
      "name": "AckText",
      "properties": {
        "format": "Acks: {}",
        "type": "int32"
      }
    },
    {
      "id": "ackoled",
      "type": "ssd1306-text",
      "name": "oled",
      "properties": {
        "line": "3"
      }
    },
    {
      "id": "ackrst",
      "type": "variable-read",
      "name": "AckReset"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "The receiver, now acknowledging. It does everything heltec-lora-receiver-simple does, then sends an ack back carrying the count it just received, and tallies how many acks it has sent. The detail to notice: receive (n1) and the ack transmit (acktx) share the ONE 'lora' radio - the SX1262 is half-duplex, so the ack fires on n1's 'available' signal, right after a packet lands, rather than at the same time as receiving. Pair with heltec-lora-transmitter-ack."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "n1",
        "port": "payload"
      },
      "to": {
        "node": "n3",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "en",
        "port": "value"
      },
      "to": {
        "node": "n1",
        "port": "enable"
      }
    },
    {
      "from": {
        "node": "n3",
        "port": "out_pressCount"
      },
      "to": {
        "node": "fmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "rssi"
      },
      "to": {
        "node": "n6",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "fmt",
        "port": "text"
      },
      "to": {
        "node": "n9",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "n6",
        "port": "text"
      },
      "to": {
        "node": "n10",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "n3",
        "port": "out_pressCount"
      },
      "to": {
        "node": "ackbuild",
        "port": "in_ackCount"
      }
    },
    {
      "from": {
        "node": "ackbuild",
        "port": "payload"
      },
      "to": {
        "node": "acktx",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "available"
      },
      "to": {
        "node": "acktx",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "acktx",
        "port": "done"
      },
      "to": {
        "node": "ackcnt",
        "port": "CU"
      }
    },
    {
      "from": {
        "node": "ackcnt",
        "port": "CV"
      },
      "to": {
        "node": "ackfmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "ackfmt",
        "port": "text"
      },
      "to": {
        "node": "ackoled",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "ackrst",
        "port": "value"
      },
      "to": {
        "node": "ackcnt",
        "port": "R"
      }
    }
  ],
  "variables": [
    {
      "name": "RadioEnable",
      "type": "bool",
      "initial": "true"
    },
    {
      "name": "AckReset",
      "type": "bool",
      "initial": "false"
    }
  ],
  "hardware": [],
  "peripherals": [
    {
      "name": "lora",
      "type": "semtech:sx1262"
    },
    {
      "name": "oled",
      "type": "solomon:ssd1306"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 360
      },
      "ackbuild": {
        "x": 564.6851200000001,
        "y": 342.14191999999986
      },
      "ackcnt": {
