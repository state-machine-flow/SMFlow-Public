        "y": 319.88759999999974
      },
      "ackfmt": {
        "x": 1409.01728,
        "y": 319.88759999999974
      },
      "ackoled": {
        "x": 1649.01728,
        "y": 319.88759999999974
      },
      "ackrst": {
        "x": 883.2249600000002,
        "y": 482.14191999999963
      },
      "acktx": {
        "x": 875.0501599999999,
        "y": 305.7439999999999
      },
      "en": {
        "x": 42.29600000000025,
        "y": 118.58399999999992
      },
      "fmt": {
        "x": 821.2799200000004,
        "y": 73.29447999999998
      },
      "n1": {
        "x": 274.0000000000001,
        "y": 116.00000000000003
      },
      "n10": {
        "x": 1105.50384,
        "y": 637.1296800000001
      },
      "n3": {
        "x": 572.44912,
        "y": 71.08927999999997
      },
      "n6": {
        "x": 554.02664,
        "y": 636.6743200000001
      },
      "n8": {
        "x": 52.400000000000006,
        "y": 136.00000000000009
      },
      "n9": {
        "x": 1116.33256,
        "y": 51.721119999999914
      }
    }
  }
}
