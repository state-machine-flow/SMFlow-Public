        "x": 491.19999999999993,
        "y": 280.0
      },
      "fmt": {
        "x": 1038.0824000000002,
        "y": 475.1935999999999
      },
      "inc": {
        "x": 260.0,
        "y": 140.0
      },
      "led": {
        "x": 1028.7999999999997,
        "y": 15.200000000000003
      },
      "oled": {
        "x": 1290.897864,
        "y": 448.48240000000004
      },
      "read_count": {
        "x": 260.0,
        "y": 380.0
      },
      "read_one": {
        "x": 40.0,
        "y": 200.0
      },
      "read_zero": {
        "x": 40.0,
        "y": 320.0
      },
      "rssifmt": {
        "x": 835.1536319999998,
        "y": 871.7248800000002
      },
      "rssioled": {
        "x": 1073.2231839999997,
        "y": 877.2531280000001
      },
      "rx": {
        "x": 305.1536319999998,
        "y": 741.7248800000002
      },
      "rxen": {
        "x": 45.15363199999979,
