{
  "formatVersion": 6,
  "name": "heltec-lora-transmitter-ack",
  "target": "heltec-lora32-v3",
  "targets": [
    "esp32-s3",
    "heltec-lora32-v3"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "btn",
      "type": "digital-input",
      "name": "Button"
    },
    {
      "id": "read_one",
      "type": "variable-read",
      "name": "One"
    },
    {
      "id": "read_zero",
      "type": "variable-read",
      "name": "Zero"
    },
    {
      "id": "inc",
      "type": "select",
      "properties": {
        "type": "int32"
      }
    },
    {
      "id": "accumulate",
      "type": "variable-update",
      "name": "PressCount",
      "properties": {
        "operation": "add"
      }
    },
    {
      "id": "save",
      "type": "persist-save",
      "properties": {
        "region": "retained"
      }
    },
    {
      "id": "read_count",
      "type": "variable-read",
      "name": "PressCount"
    },
    {
      "id": "builder",
      "type": "create-payload",
      "properties": {
        "schema": "pressCount:int32:be"
      },
      "comment": "Packs PressCount into the outbound bytes. Its schema must match the receiver's unpack-payload. PressCount is a retained variable (saved to NVS on each press), so the running count survives a reboot."
    },
    {
      "id": "tx",
      "type": "sx1262-tx",
      "name": "Radio"
    },
    {
      "id": "led",
      "type": "digital-output",
      "name": "Busy"
    },
    {
      "id": "fmt",
      "type": "to-text",
      "name": "CountText",
      "properties": {
        "format": "Sent: {}",
        "type": "int32"
      }
    },
    {
      "id": "oled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "0"
      }
    },
    {
      "id": "rxen",
      "type": "variable-read",
      "name": "RadioEnable"
    },
    {
      "id": "rx",
      "type": "sx1262-rx",
      "name": "Radio",
      "comment": "Receives the ack on the SAME 'Radio' peripheral that tx sends on - the SX1262 is half-duplex, so it listens after the send rather than at the same time. 'payload' is the ack bytes; 'rssi' is the ack's signal strength, shown so you can judge the return link quality."
    },
    {
      "id": "ackunp",
      "type": "unpack-payload",
      "properties": {
        "schema": "ackCount:int32:be"
      },
      "comment": "Decodes the ack. This schema must match the receiver's ack create-payload ('ackCount:int32:be'). The decoded ackCount is the count the receiver echoed back, so comparing it to what you sent confirms the round trip."
    },
    {
      "id": "ackfmt",
      "type": "to-text",
      "name": "AckText",
      "properties": {
        "format": "Ack: {}",
        "type": "int32"
      }
    },
    {
      "id": "ackoled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "1"
      }
    },
    {
      "id": "rssifmt",
      "type": "to-text",
      "name": "AckRssiText",
      "properties": {
        "format": "RSSI: {0.00}",
        "type": "float32"
      }
    },
    {
      "id": "rssioled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "2"
      }
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "A full round-trip LoRa node: it sends a press count and then listens for the receiver's ack on the one shared SX1262 (half-duplex). The count is kept in a retained variable saved to NVS, so it survives power cycles. The OLED shows the count sent, the ack value echoed back, and the ack's RSSI. The on-canvas groups ('Send Count', 'Receive ACK') are just visual grouping - they carry no behavior. Pair with heltec-lora-receiver-ack."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "cond"
      }
    },
    {
      "from": {
        "node": "read_one",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "whenTrue"
      }
    },
    {
      "from": {
        "node": "read_zero",
        "port": "value"
      },
      "to": {
        "node": "inc",
        "port": "whenFalse"
      }
    },
    {
      "from": {
        "node": "inc",
        "port": "out"
      },
      "to": {
        "node": "accumulate",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "save",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "tx",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "read_count",
        "port": "value"
      },
      "to": {
        "node": "builder",
        "port": "in_pressCount"
      }
    },
    {
      "from": {
        "node": "builder",
        "port": "payload"
      },
      "to": {
        "node": "tx",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "busy"
      },
      "to": {
        "node": "led",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "read_count",
        "port": "value"
      },
      "to": {
        "node": "fmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "fmt",
        "port": "text"
      },
      "to": {
        "node": "oled",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "rxen",
        "port": "value"
      },
      "to": {
        "node": "rx",
        "port": "enable"
      }
    },
    {
      "from": {
        "node": "rx",
        "port": "payload"
      },
      "to": {
        "node": "ackunp",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "ackunp",
        "port": "out_ackCount"
      },
      "to": {
        "node": "ackfmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "ackfmt",
        "port": "text"
      },
      "to": {
        "node": "ackoled",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "rx",
        "port": "rssi"
      },
      "to": {
        "node": "rssifmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "rssifmt",
        "port": "text"
      },
      "to": {
        "node": "rssioled",
        "port": "text"
      }
    }
  ],
  "variables": [
    {
      "name": "PressCount",
      "type": "int32",
      "initial": "0",
      "persistence": "retained"
    },
    {
      "name": "One",
      "type": "int32",
      "initial": "1",
      "persistence": "none"
    },
    {
      "name": "Zero",
      "type": "int32",
      "initial": "0",
      "persistence": "none"
    },
    {
      "name": "RadioEnable",
      "type": "bool",
      "initial": "true"
    }
  ],
  "persistence": {
    "retained": {
      "esp32-s3": "nvs0",
      "heltec-lora32-v3": "nvs0"
    }
  },
  "hardware": [
    {
      "logical": "Button",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Busy",
      "direction": "output",
      "type": "bool"
    }
  ],
  "peripherals": [
    {
      "name": "Radio",
      "type": "semtech:sx1262"
    },
    {
      "name": "Oled",
      "type": "solomon:ssd1306"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 1080
      },
      "accumulate": {
        "x": 480.0,
        "y": 140.0
      },
      "ackfmt": {
        "x": 814.8256319999999,
        "y": 726.2368800000003
      },
      "ackoled": {
        "x": 1071.6550239999992,
        "y": 710.803088
      },
      "ackunp": {
        "x": 582.2496319999998,
        "y": 696.8688800000002
      },
      "btn": {
        "x": 40.0,
        "y": 80.0
      },
