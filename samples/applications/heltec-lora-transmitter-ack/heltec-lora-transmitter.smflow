        "x": 1071.6550239999992,
        "y": 710.803088
      },
      "ackunp": {
        "x": 582.2496319999998,
        "y": 696.8688800000002
      },
      "btn": {
        "x": 40,
        "y": 80
      },
      "builder": {
        "x": 491.19999999999993,
        "y": 221.6000000000001
      },
