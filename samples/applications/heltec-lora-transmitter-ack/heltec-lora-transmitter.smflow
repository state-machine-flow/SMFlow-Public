      }
    },
    "groups": [
      {
        "id": "g1",
        "label": "Receive ACK",
        "x": 21.15363199999979,
        "y": 658.8688800000002,
        "width": 1332.7276639999998,
        "height": 380.05534399999976,
        "task": "Main"
      },
      {
        "id": "g2",
        "label": "Send Count",
        "x": 2.799999999999983,
