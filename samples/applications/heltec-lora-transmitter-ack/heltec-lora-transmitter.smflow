{
  "formatVersion": 5,
  "name": "lora-press-counter",
  "target": "heltec-lora32-v3",
  "targets": [
    "esp32-s3",
    "heltec-lora32-v3"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "btn",
      "type": "digital-input",
      "name": "Button"
    },
    {
      "id": "cnt",
      "type": "counter",
      "properties": {
        "presetCount": "1000"
      }
    },
    {
      "id": "builder",
      "type": "create-payload",
      "properties": {
        "schema": "pressCount:int32:be"
      }
    },
    {
      "id": "tx",
      "type": "sx1262-tx",
      "name": "Radio"
    },
    {
      "id": "led",
      "type": "digital-output",
      "name": "Busy"
    },
    {
      "id": "n1",
      "type": "digital-input",
      "name": "Input1"
    },
    {
      "id": "n2",
      "type": "digital-output",
      "name": "Done"
    },
    {
      "id": "n3",
      "type": "digital-output",
      "name": "Error"
    },
    {
      "id": "n5",
      "type": "counter",
      "properties": {
        "presetCount": "10"
      }
    },
    {
      "id": "fmt",
      "type": "to-text",
      "name": "CountText",
      "properties": {
        "format": "Sent: {}",
        "type": "int32"
      }
    },
    {
      "id": "oled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "0"
      }
    },
    {
      "id": "rxen",
      "type": "variable-read",
      "name": "RadioEnable"
    },
    {
      "id": "rx",
      "type": "sx1262-rx",
      "name": "Radio"
    },
    {
      "id": "ackunp",
      "type": "unpack-payload",
      "properties": {
        "schema": "ackCount:int32:be"
      }
    },
    {
      "id": "ackfmt",
      "type": "to-text",
      "name": "AckText",
      "properties": {
        "format": "Ack: {}",
        "type": "int32"
      }
    },
    {
      "id": "ackoled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "1"
      }
    },
    {
      "id": "rssifmt",
      "type": "to-text",
      "name": "AckRssiText",
      "properties": {
        "format": "RSSI: {0.00}",
        "type": "float32"
      }
    },
    {
      "id": "rssioled",
      "type": "ssd1306-text",
      "name": "Oled",
      "properties": {
        "line": "2"
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "cnt",
        "port": "CU"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "tx",
        "port": "trigger"
      }
    },
    {
      "from": {
        "node": "cnt",
        "port": "CV"
      },
      "to": {
        "node": "builder",
        "port": "in_pressCount"
      }
    },
    {
      "from": {
        "node": "builder",
        "port": "payload"
      },
      "to": {
        "node": "tx",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "busy"
      },
      "to": {
        "node": "led",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "cnt",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "done"
      },
      "to": {
        "node": "n2",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "error"
      },
      "to": {
        "node": "n3",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "tx",
        "port": "done"
      },
      "to": {
        "node": "n5",
        "port": "CU"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n5",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "cnt",
        "port": "CV"
      },
      "to": {
        "node": "fmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "fmt",
        "port": "text"
      },
      "to": {
        "node": "oled",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "rxen",
        "port": "value"
      },
      "to": {
        "node": "rx",
        "port": "enable"
      }
    },
    {
      "from": {
        "node": "rx",
        "port": "payload"
      },
      "to": {
        "node": "ackunp",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "ackunp",
        "port": "out_ackCount"
      },
      "to": {
        "node": "ackfmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "ackfmt",
        "port": "text"
      },
      "to": {
        "node": "ackoled",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "rx",
        "port": "rssi"
      },
      "to": {
        "node": "rssifmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "rssifmt",
        "port": "text"
      },
      "to": {
        "node": "rssioled",
        "port": "text"
      }
    }
  ],
  "variables": [
    {
      "name": "RadioEnable",
      "type": "bool",
      "initial": "true"
    }
  ],
  "hardware": [
    {
      "logical": "Button",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Busy",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Input1",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Done",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Error",
      "direction": "output",
      "type": "bool"
    }
  ],
  "peripherals": [
    {
      "name": "Radio",
      "type": "semtech:sx1262"
    },
    {
      "name": "Oled",
      "type": "solomon:ssd1306"
    }
  ],
  "ui": {
    "nodes": {
      "ackfmt": {
        "x": 814.8256319999999,
        "y": 726.2368800000003
      },
