        "x": 1024.3159999999998,
        "y": 360.04479999999995
      },
      "n5": {
        "x": 1034.2368000000001,
        "y": 227.228
      },
      "oled": {
        "x": 1290.897864,
        "y": 448.48240000000004
      },
      "rssifmt": {
        "x": 835.1536319999998,
        "y": 871.7248800000002
      },
      "rssioled": {
        "x": 1073.2231839999997,
        "y": 877.2531280000001
      },
      "rx": {
        "x": 305.1536319999998,
        "y": 741.7248800000002
      },
      "rxen": {
        "x": 45.15363199999979,
        "y": 761.7248800000002
      },
      "tx": {
        "x": 751.1999999999998,
