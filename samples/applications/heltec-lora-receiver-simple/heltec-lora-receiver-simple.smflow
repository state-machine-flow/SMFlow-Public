{
  "formatVersion": 5,
  "name": "heltec-lora-receiver-simple",
  "target": "heltec-lora32-v3",
  "targets": [
    "heltec-lora32-v3"
  ],
  "tasks": [
    {
      "name": "main",
      "periodMs": 10
    },
    {
      "name": "task2",
      "periodMs": 0,
      "kind": "init"
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "sx1262-rx",
      "name": "lora",
      "comment": "LoRa receive node for the SX1262 radio (the 'lora' peripheral). 'payload' is the raw bytes of the most recent packet; 'rssi' is its received signal strength in dBm; 'enable' gates the radio on and off. Frequency, bandwidth and spreading factor are not set here - they live in the .iomap and must match the transmitter."
    },
    {
      "id": "n3",
      "type": "unpack-payload",
      "properties": {
        "schema": "pressCount:int32:be"
      },
      "comment": "Decodes the raw bytes into named fields using a 'field:type:endian' schema. Here the single field pressCount (big-endian int32) appears as the output port out_pressCount. A LoRa packet has no self-describing header, so this schema must match the transmitter's pack-payload schema exactly or the bytes decode to nonsense."
    },
    {
      "id": "en",
      "type": "variable-read",
      "name": "RadioEnable"
    },
    {
      "id": "fmt",
      "type": "to-text",
      "properties": {
        "format": "Count: {}",
        "type": "int32"
      }
    },
    {
      "id": "n6",
      "type": "to-text",
      "properties": {
        "format": "RSSI: {0.00}",
        "type": "float32"
      }
    },
    {
      "id": "n8",
      "type": "ssd1306-text",
      "name": "oled",
      "task": "task2",
      "properties": {
        "text": "LoRa Rx"
      }
    },
    {
      "id": "n9",
      "type": "ssd1306-text",
      "name": "oled",
      "properties": {
        "line": "1"
      }
    },
    {
      "id": "n10",
      "type": "ssd1306-text",
      "name": "oled",
      "properties": {
        "line": "2"
      }
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "The receiving half of a LoRa link - pair it with heltec-lora-transmitter-simple. Each scan it takes the latest packet off the SX1262 radio, unpacks a big-endian int32 'pressCount' from the raw bytes, and shows the count plus the signal strength (RSSI) on the OLED. The init task paints the static 'LoRa Rx' title once. The key idea: LoRa carries opaque bytes, so both ends must agree on the payload schema by hand."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "n1",
        "port": "payload"
      },
      "to": {
        "node": "n3",
        "port": "payload"
      }
    },
    {
      "from": {
        "node": "en",
        "port": "value"
      },
      "to": {
        "node": "n1",
        "port": "enable"
      }
    },
    {
      "from": {
        "node": "n3",
        "port": "out_pressCount"
      },
      "to": {
        "node": "fmt",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "rssi"
      },
      "to": {
        "node": "n6",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "fmt",
        "port": "text"
      },
      "to": {
        "node": "n9",
        "port": "text"
      }
    },
    {
      "from": {
        "node": "n6",
        "port": "text"
      },
      "to": {
        "node": "n10",
        "port": "text"
      }
    }
  ],
  "variables": [
    {
      "name": "RadioEnable",
      "type": "bool",
      "initial": "true"
    }
  ],
  "hardware": [],
  "peripherals": [
    {
      "name": "lora",
      "type": "semtech:sx1262"
    },
    {
      "name": "oled",
      "type": "solomon:ssd1306"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 45,
        "y": 440
      },
      "en": {
        "x": 45.200000000000216,
        "y": 154.39999999999995
      },
      "fmt": {
        "x": 775.6000000000003,
        "y": 142.39999999999995
      },
      "n1": {
        "x": 274.0000000000001,
        "y": 116.00000000000003
      },
      "n10": {
        "x": 1248.3999999999999,
        "y": 308
      },
      "n3": {
        "x": 509.20000000000005,
        "y": 99.19999999999996
      },
      "n6": {
        "x": 538.8000000000001,
        "y": 321.6
      },
      "n8": {
        "x": 52.400000000000006,
        "y": 136.00000000000009
      },
      "n9": {
        "x": 1260.3999999999999,
        "y": 105.6
      }
    }
  }
}
