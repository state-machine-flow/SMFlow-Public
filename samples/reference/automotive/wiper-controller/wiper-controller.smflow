    },
    {
      "from": {
        "node": "not_fault",
        "port": "out"
      },
      "to": {
        "node": "gate_motor_high",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "not_fault",
        "port": "out"
      },
      "to": {
        "node": "gate_washer_pump",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "gate_motor_low",
        "port": "out"
      },
      "to": {
        "node": "out_motor_low",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "gate_motor_high",
        "port": "out"
      },
      "to": {
        "node": "out_motor_high",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "gate_washer_pump",
        "port": "out"
      },
      "to": {
        "node": "out_washer_pump",
        "port": "value"
      }
    }
  ],
  "variables": [],
  "hardware": [
    {
      "logical": "Ignition",
