        "node": "gate_high_req",
        "port": "out"
      },
      "to": {
        "node": "not_high",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "gate_high_req",
        "port": "out"
      },
      "to": {
        "node": "gate_continuous",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "gate_high_req",
        "port": "out"
      },
      "to": {
        "node": "gate_motor_high",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "gate_low_req",
        "port": "out"
      },
      "to": {
        "node": "gate_low_cmd",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "gate_low_req",
        "port": "out"
      },
      "to": {
        "node": "gate_continuous",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "not_high",
        "port": "out"
      },
      "to": {
        "node": "gate_low_cmd",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "gate_continuous",
        "port": "out"
      },
      "to": {
        "node": "not_continuous",
