    {
      "from": {
        "node": "not_parked",
        "port": "out"
      },
      "to": {
        "node": "gate_stall_running",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "gate_cmd_any",
        "port": "out"
      },
