      }
    },
    {
      "from": {
        "node": "timer_int_delay",
        "port": "Q"
      },
      "to": {
        "node": "edge_int_timer",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "edge_int_start",
        "port": "Q"
      },
      "to": {
        "node": "gate_int_wipe_trig",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "edge_int_timer",
        "port": "Q"
      },
      "to": {
