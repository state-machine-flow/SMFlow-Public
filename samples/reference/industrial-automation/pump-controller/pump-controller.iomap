      "PumpContactor": "GP20",
      "AlarmOutput": "GP21",
      "PumpRunningOutput": "GP22",
      "AutoModeOutput": "GP27"
    },
    "simulator": {
      "ProcessVariable": "virtual.ProcessVariable",
      "AutoSwitch": "virtual.AutoSwitch",
