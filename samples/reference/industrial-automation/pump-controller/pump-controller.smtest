    OverloadFault = false
    AlarmReset = false
    ProcessVariable = 50.0

When:
    execute 1 cycle
    OverloadFault = true
    execute 1 cycle

Then:
    PumpContactor == false
    PumpRunningOutput == false
    AlarmOutput == true

