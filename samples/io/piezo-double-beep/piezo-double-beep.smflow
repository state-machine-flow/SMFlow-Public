{
  "formatVersion": 5,
  "name": "piezo-double-beep",
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "always",
      "type": "variable-read",
      "name": "Always"
    },
    {
      "id": "window",
      "type": "ton",
      "properties": {
        "presetTime": "300"
      },
      "comment": "Defines a 300 ms startup window. Fed by the constant Always=true, this on-delay's Q goes true 300 ms after boot and then stays true; notDone inverts it, so notDone is true only during the first 300 ms. This is how you get 'run only at startup' without a dedicated init task."
    },
    {
      "id": "notDone",
      "type": "not"
    },
    {
      "id": "pulses",
      "type": "blink",
      "properties": {
        "timeHigh": "100",
        "timeLow": "100"
      },
      "comment": "A 5 Hz pulse train (100 ms on / 100 ms off). On its own it would beep forever. ANDed with the 300 ms window below, only the pulses inside that window survive - two of them - which is what makes it a *double* beep."
    },
    {
      "id": "gate",
      "type": "and"
    },
    {
      "id": "hzOn",
      "type": "variable-read",
      "name": "AlarmHz"
    },
    {
      "id": "hzOff",
      "type": "variable-read",
      "name": "Silent"
    },
    {
      "id": "pick",
      "type": "select",
      "properties": {
        "type": "float32"
      },
      "comment": "select as a mux: buzzer frequency = gate ? AlarmHz(2700) : Silent(0). The boolean 'beep now' gate becomes a frequency or silence for the tone output - the bridge from logic to an analog-style output."
    },
    {
      "id": "buzzer",
      "type": "tone-output",
      "name": "Buzzer"
    },
    {
      "id": "heartbeat",
      "type": "blink",
      "properties": {
        "timeHigh": "500",
        "timeLow": "500"
      },
      "comment": "A separate 1 Hz LED blink with nothing to do with the beep. It shows two independently-timed behaviors living in the same task and scan."
    },
    {
      "id": "led",
      "type": "digital-output",
      "name": "Heartbeat"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "A power-on double beep, then silence, alongside a forever LED heartbeat. The idea: a 300 ms on-delay (window) marks a startup period, and ANDing it with a 100/100 ms blink lets exactly two pulses through before the window closes for good. A select turns that gate into a tone frequency. Nothing actually stops - the beep just ends because its gate stays false afterward. Gating a tone with select, on a board that needs nothing wired but the piezo."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "always",
        "port": "value"
      },
      "to": {
        "node": "window",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "always",
        "port": "value"
      },
      "to": {
        "node": "pulses",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "always",
        "port": "value"
      },
      "to": {
        "node": "heartbeat",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "window",
        "port": "Q"
      },
      "to": {
        "node": "notDone",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "notDone",
        "port": "out"
      },
      "to": {
        "node": "gate",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "pulses",
        "port": "Q"
      },
      "to": {
        "node": "gate",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "gate",
        "port": "out"
      },
      "to": {
        "node": "pick",
        "port": "cond"
      }
    },
    {
      "from": {
        "node": "hzOn",
        "port": "value"
      },
      "to": {
        "node": "pick",
        "port": "whenTrue"
      }
    },
    {
      "from": {
        "node": "hzOff",
        "port": "value"
      },
      "to": {
        "node": "pick",
        "port": "whenFalse"
      }
    },
    {
      "from": {
        "node": "pick",
        "port": "out"
      },
      "to": {
        "node": "buzzer",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "heartbeat",
        "port": "Q"
      },
      "to": {
        "node": "led",
        "port": "value"
      }
    }
  ],
  "variables": [
    {
      "name": "Always",
      "type": "bool",
      "initial": "true"
    },
    {
      "name": "AlarmHz",
      "type": "float32",
      "initial": "2700"
    },
    {
      "name": "Silent",
      "type": "float32",
      "initial": "0"
    }
  ],
  "hardware": [
    {
      "logical": "Buzzer",
      "direction": "output",
      "type": "float32",
      "channel": "tone"
    },
    {
      "logical": "Heartbeat",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 580
      },
      "always": {
        "x": 40,
        "y": 120
      },
      "buzzer": {
        "x": 1000,
        "y": 200
      },
      "gate": {
        "x": 620,
        "y": 120
      },
      "heartbeat": {
        "x": 240,
        "y": 460
      },
      "hzOff": {
        "x": 620,
        "y": 340
      },
      "hzOn": {
        "x": 620,
        "y": 260
      },
      "led": {
        "x": 460,
        "y": 460
      },
      "notDone": {
        "x": 440,
        "y": 40
      },
      "pick": {
        "x": 820,
        "y": 200
      },
      "pulses": {
        "x": 240,
        "y": 200
      },
      "window": {
        "x": 240,
        "y": 40
      }
    }
  }
}
