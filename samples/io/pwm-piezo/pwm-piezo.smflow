{
  "formatVersion": 5,
  "name": "pwm-piezo",
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "speed",
      "type": "analog-input",
      "name": "Speed"
    },
    {
      "id": "drive",
      "type": "pwm-output",
      "name": "Drive",
      "comment": "pwm-output's value is a duty cycle from 0.0 (off) to 1.0 (always on) - not a voltage. The Speed reading sets the duty directly."
    },
    {
      "id": "pitch",
      "type": "variable-read",
      "name": "AlarmHz"
    },
    {
      "id": "buzzer",
      "type": "tone-output",
      "name": "Buzzer",
      "comment": "tone-output's value is a frequency in hertz, not a duty cycle (0 or below is silence). 2700 Hz sits near a typical piezo's resonant peak, where it is loudest. A float output alone can't say whether it means duty, hertz or volts - the hardware 'channel' (here 'tone' vs 'pwm' on Drive) is what settles that."
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "Two independent numeric outputs in one scan: a Speed reading drives a PWM duty cycle, and a fixed AlarmHz drives a piezo tone. Each of pwm-output and tone-output claims a hardware timer on the target, so on a small MCU take care not to ask for more PWM/tone channels than the chip has timers to back them."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "speed",
        "port": "value"
      },
      "to": {
        "node": "drive",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "pitch",
        "port": "value"
      },
      "to": {
        "node": "buzzer",
        "port": "value"
      }
    }
  ],
  "variables": [
    {
      "name": "AlarmHz",
      "type": "float32",
      "initial": "2700"
    }
  ],
  "hardware": [
    {
      "logical": "Speed",
      "direction": "input",
      "type": "float32"
    },
    {
      "logical": "Drive",
      "direction": "output",
      "type": "float32",
      "channel": "pwm"
    },
    {
      "logical": "Buzzer",
      "direction": "output",
      "type": "float32",
      "channel": "tone"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 60,
        "y": 340
      },
      "buzzer": {
        "x": 320,
        "y": 200
      },
      "drive": {
        "x": 320,
        "y": 60
      },
      "pitch": {
        "x": 60,
        "y": 200
      },
      "speed": {
        "x": 60,
        "y": 60
      }
    }
  }
}
