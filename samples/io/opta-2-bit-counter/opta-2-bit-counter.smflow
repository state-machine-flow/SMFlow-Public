{
  "formatVersion": 4,
  "name": "opta-2-bit-counter",
  "target": "opta",
  "targets": [
    "opta",
    "simulator"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "btn",
      "type": "digital-input",
      "name": "UserButton",
      "comment": "On-board user pushbutton. Bound with a pull-up, so the Opta target reads it active-low: pressed is true, idle is false, and a press is a clean rising edge."
    },
    {
      "id": "rst",
      "type": "digital-input",
      "name": "ResetButton",
      "comment": "External reset input (terminal I1) that clears the sequence and de-energizes all relays."
    },
    {
      "id": "t0",
      "type": "toggle",
      "comment": "Bit 0 toggle flip-flop. Toggles on every button press (0 -> 1 -> 0 -> 1)."
    },
    {
      "id": "fe0",
      "type": "falling-edge",
      "comment": "Clocks Bit 1 strictly on Bit 0 falling edge (1 -> 0), preventing scan-1 boot transients."
    },
    {
      "id": "inv_t0",
      "type": "not",
      "comment": "Inverts Bit 0 (NOT Bit 0) for the 1-of-4 decoder gates."
    },
    {
      "id": "t1",
      "type": "toggle",
      "comment": "Bit 1 toggle flip-flop. Toggles every two button presses (ripple counter)."
    },
    {
      "id": "inv_t1",
      "type": "not",
      "comment": "Inverts Bit 1 (NOT Bit 1) for the 1-of-4 decoder gates."
    },
    {
      "id": "started",
      "type": "set-reset",
      "comment": "Boot latch that stays false until the first button press, ensuring all relays start de-energized."
    },
    {
      "id": "and_r1",
      "type": "and",
      "comment": "Relay 1 decoder: Bit 0 AND NOT Bit 1 (binary 01)."
    },
    {
      "id": "out_r1",
      "type": "digital-output",
      "name": "Relay1",
      "comment": "Physical output driving Relay 1 (OUTPUT 1 / D0)."
    },
    {
      "id": "and_r2",
      "type": "and",
      "comment": "Relay 2 decoder: NOT Bit 0 AND Bit 1 (binary 10)."
    },
    {
      "id": "out_r2",
      "type": "digital-output",
      "name": "Relay2",
      "comment": "Physical output driving Relay 2 (OUTPUT 2 / D1)."
    },
    {
      "id": "and_r3",
      "type": "and",
      "comment": "Relay 3 decoder: Bit 0 AND Bit 1 (binary 11)."
    },
    {
      "id": "out_r3",
      "type": "digital-output",
      "name": "Relay3",
      "comment": "Physical output driving Relay 3 (OUTPUT 3 / D2)."
    },
    {
      "id": "and_r4_raw",
      "type": "and",
      "comment": "Raw state 00 decode: NOT Bit 0 AND NOT Bit 1."
    },
    {
      "id": "and_r4",
      "type": "and",
      "comment": "Relay 4 qualifier: State 00 AND Started (keeps Relay 4 off at power-on)."
    },
    {
      "id": "out_r4",
      "type": "digital-output",
      "name": "Relay4",
      "comment": "Physical output driving Relay 4 (OUTPUT 4 / D3)."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "t0",
        "port": "CLK"
      }
    },
    {
      "from": {
        "node": "rst",
        "port": "value"
      },
      "to": {
        "node": "t0",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "btn",
        "port": "value"
      },
      "to": {
        "node": "started",
        "port": "S"
      }
    },
    {
      "from": {
        "node": "rst",
        "port": "value"
      },
      "to": {
        "node": "started",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "t0",
        "port": "Q"
      },
      "to": {
        "node": "fe0",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "fe0",
        "port": "Q"
      },
      "to": {
        "node": "t1",
        "port": "CLK"
      }
    },
    {
      "from": {
        "node": "rst",
        "port": "value"
      },
      "to": {
        "node": "t1",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "t0",
        "port": "Q"
      },
      "to": {
        "node": "inv_t0",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "t1",
        "port": "Q"
      },
      "to": {
        "node": "inv_t1",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "t0",
        "port": "Q"
      },
      "to": {
        "node": "and_r1",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "inv_t1",
        "port": "out"
      },
      "to": {
        "node": "and_r1",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "and_r1",
        "port": "out"
      },
      "to": {
        "node": "out_r1",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "inv_t0",
        "port": "out"
      },
      "to": {
        "node": "and_r2",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "t1",
        "port": "Q"
      },
      "to": {
        "node": "and_r2",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "and_r2",
        "port": "out"
      },
      "to": {
        "node": "out_r2",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "t0",
        "port": "Q"
      },
      "to": {
        "node": "and_r3",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "t1",
        "port": "Q"
      },
      "to": {
        "node": "and_r3",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "and_r3",
        "port": "out"
      },
      "to": {
        "node": "out_r3",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "inv_t0",
        "port": "out"
      },
      "to": {
        "node": "and_r4_raw",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "inv_t1",
        "port": "out"
      },
      "to": {
        "node": "and_r4_raw",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "and_r4_raw",
        "port": "out"
      },
      "to": {
        "node": "and_r4",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "started",
        "port": "Q"
      },
      "to": {
        "node": "and_r4",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "and_r4",
        "port": "out"
      },
      "to": {
        "node": "out_r4",
        "port": "value"
      }
    }
  ],
  "hardware": [
    {
      "logical": "UserButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "ResetButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Relay1",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay2",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay3",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay4",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "btn": {
        "x": 40,
        "y": 60
      },
      "rst": {
        "x": 40,
        "y": 220
      },
      "started": {
        "x": 180,
        "y": 220
      },
      "t0": {
        "x": 340,
        "y": 60
      },
      "fe0": {
        "x": 480,
        "y": 60
      },
      "inv_t0": {
        "x": 480,
        "y": 140
      },
      "t1": {
        "x": 620,
        "y": 60
      },
      "inv_t1": {
        "x": 760,
        "y": 60
      },
      "and_r1": {
        "x": 920,
        "y": 40
      },
      "out_r1": {
        "x": 1080,
        "y": 40
      },
      "and_r2": {
        "x": 920,
        "y": 140
      },
      "out_r2": {
        "x": 1080,
        "y": 140
      },
      "and_r3": {
        "x": 920,
        "y": 240
      },
      "out_r3": {
        "x": 1080,
        "y": 240
      },
      "and_r4_raw": {
        "x": 920,
        "y": 340
      },
      "and_r4": {
        "x": 1060,
        "y": 340
