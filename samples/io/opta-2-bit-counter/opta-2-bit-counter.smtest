test "all relays off at boot"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle

Then:
    Relay1 == false
    Relay2 == false
    Relay3 == false
    Relay4 == false

test "first press energizes relay 1"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle

Then:
    Relay1 == true
    Relay2 == false
    Relay3 == false
    Relay4 == false

test "second press energizes relay 2"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle

Then:
    Relay1 == false
    Relay2 == true
    Relay3 == false
    Relay4 == false

