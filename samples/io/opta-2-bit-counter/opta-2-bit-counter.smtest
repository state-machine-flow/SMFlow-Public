test "fourth press energizes relay 4"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
