test "fifth press cycles back to relay 1"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle

Then:
    Relay1 == true
    Relay2 == false
    Relay3 == false
    Relay4 == false

test "reset button turns off all relays"

Given:
    UserButton = false
    ResetButton = false

When:
    execute 1 cycle
    UserButton = true
    execute 1 cycle
    UserButton = false
    execute 1 cycle
    ResetButton = true
    execute 1 cycle

Then:
    Relay1 == false
    Relay2 == false
    Relay3 == false
    Relay4 == false
