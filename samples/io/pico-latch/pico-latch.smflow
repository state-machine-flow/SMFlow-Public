{
  "formatVersion": 4,
  "name": "pico-latch",
  "target": "rp2040-pico",
  "targets": [
    "rp2040-pico",
    "simulator"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "digital-input",
      "name": "StartButton"
    },
    {
      "id": "n2",
      "type": "digital-input",
      "name": "StopButton"
    },
    {
      "id": "n3",
      "type": "set-reset",
      "comment": "A set/reset latch - this is the memory. Q latches true on S (StartButton) and stays true after the button is released; R (StopButton) clears it. It holds its state between scans. Set-dominant: if S and R are held at once, Q stays true (the IEC SR convention)."
    },
    {
      "id": "n4",
      "type": "digital-output",
      "name": "RunLamp"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "The classic start/stop seal-in: a momentary Start latches the RunLamp on, a momentary Stop clears it. Without the latch the lamp would only be lit while a button was physically held. The three logical names are bound to real Pico GPIO pins in pico-latch.iomap (buttons to ground, active-low; lamp on its own pin) - that split between the flow and the pin map is the point of the .iomap file."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n3",
        "port": "S"
      }
    },
    {
      "from": {
        "node": "n2",
        "port": "value"
      },
      "to": {
        "node": "n3",
        "port": "R"
      }
    },
    {
      "from": {
        "node": "n3",
        "port": "Q"
      },
      "to": {
        "node": "n4",
        "port": "value"
      }
    }
  ],
  "hardware": [
    {
      "logical": "StartButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "StopButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "RunLamp",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 60,
        "y": 320
      },
      "n1": {
        "x": 60,
        "y": 60
      },
      "n2": {
        "x": 60,
        "y": 200
      },
      "n3": {
        "x": 300,
        "y": 120
      },
      "n4": {
        "x": 540,
        "y": 120
      }
    }
  }
}
