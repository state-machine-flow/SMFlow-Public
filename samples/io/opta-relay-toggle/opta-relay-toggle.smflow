{
  "formatVersion": 5,
  "name": "opta-relay-toggle",
  "target": "opta",
  "targets": [
    "opta",
    "simulator"
  ],
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "enable",
      "type": "variable-read",
      "name": "Enable",
      "comment": "Always true (nothing writes it), so the blinker runs. The blink IN input is required and this is the constant that satisfies it."
    },
    {
      "id": "blink",
      "type": "blink",
      "properties": {
        "timeHigh": "1000",
        "timeLow": "1000"
      },
      "comment": "0.5 Hz square wave (1000 ms high, 1000 ms low). The button\u0027s toggle drives the pause input: while paused, Q freezes at its current level and the phase stands still, so the relays hold in place and resume mid-cycle."
    },
    {
      "id": "invert",
      "type": "not",
      "comment": "Inverts the blinker so Relays 2 and 4 are energized when Relays 1 and 3 are off, and vice versa."
    },
    {
      "id": "relay1",
      "type": "digital-output",
      "name": "Relay1"
    },
    {
      "id": "relay2",
      "type": "digital-output",
      "name": "Relay2"
    },
    {
      "id": "relay3",
      "type": "digital-output",
      "name": "Relay3"
    },
    {
      "id": "relay4",
      "type": "digital-output",
      "name": "Relay4"
    },
    {
      "id": "n1",
      "type": "digital-input",
      "name": "Input1",
      "comment": "The Opta user button. Each press pauses or resumes the blinking."
    },
    {
      "id": "n4",
      "type": "toggle",
      "comment": "Flips on every button press. Starts false (running); each press flips the blinker\u0027s pause input."
    },
    {
      "id": "n5",
      "type": "digital-output",
      "name": "Output1"
    },
    {
      "id": "n6",
      "type": "not"
    }
  ],
  "connections": [
    {
      "from": {
        "node": "enable",
        "port": "value"
      },
      "to": {
        "node": "blink",
        "port": "IN"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n4",
        "port": "CLK"
      }
    },
    {
      "from": {
        "node": "n4",
        "port": "Q"
      },
      "to": {
        "node": "blink",
        "port": "pause"
      }
    },
    {
      "from": {
        "node": "blink",
        "port": "Q"
      },
      "to": {
        "node": "relay1",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "blink",
        "port": "Q"
      },
      "to": {
        "node": "relay3",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "blink",
        "port": "Q"
      },
      "to": {
        "node": "invert",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "invert",
        "port": "out"
      },
      "to": {
        "node": "relay2",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "invert",
        "port": "out"
      },
      "to": {
        "node": "relay4",
        "port": "value"
      }
    },
    {
      "from": {
        "node": "n4",
        "port": "Q"
      },
      "to": {
        "node": "n6",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "n6",
        "port": "out"
      },
      "to": {
        "node": "n5",
        "port": "value"
      }
    }
  ],
  "variables": [
    {
      "name": "Enable",
      "type": "bool",
      "initial": "true"
    }
  ],
  "hardware": [
    {
      "logical": "Relay1",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay2",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay3",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Relay4",
      "direction": "output",
      "type": "bool"
    },
    {
      "logical": "Input1",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Output1",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "blink": {
        "x": 420,
        "y": 110.39999999999998,
        "commentExpanded": true
      },
      "enable": {
        "x": 20.000000000000057,
        "y": 48.00000000000006,
        "commentExpanded": true
      },
      "invert": {
        "x": 664.8000000000001,
        "y": 270.4,
        "commentExpanded": true
      },
      "n1": {
        "x": -46.39999999999998,
        "y": 244.80000000000007,
        "commentExpanded": true
      },
      "n4": {
        "x": 173.60000000000002,
        "y": 244.80000000000007,
        "commentExpanded": true
      },
      "n5": {
        "x": 647.6,
        "y": 443.19999999999993
      },
      "n6": {
        "x": 421.20000000000016,
        "y": 456.80000000000007
      },
      "relay1": {
        "x": 910.4000000000001,
        "y": 48
      },
      "relay2": {
        "x": 910.4000000000001,
        "y": 248
      },
      "relay3": {
        "x": 910.4000000000001,
        "y": 138
      },
      "relay4": {
        "x": 910.4000000000001,
        "y": 338
      }
    }
  }
}
