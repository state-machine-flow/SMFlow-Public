{
  "formatVersion": 4,
  "name": "motor-interlock",
  "tasks": [
    {
      "name": "main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "digital-input",
      "name": "EmergencyStop"
    },
    {
      "id": "n2",
      "type": "digital-input",
      "name": "StartButton"
    },
    {
      "id": "n3",
      "type": "not",
      "comment": "EmergencyStop is inverted so that a true E-stop forces Motor off no matter what StartButton does. On real hardware an E-stop is wired normally-closed (active-low), so a cut wire also reads as 'stop' — the fail-safe direction."
    },
    {
      "id": "n4",
      "type": "and"
    },
    {
      "id": "n5",
      "type": "digital-output",
      "name": "Motor"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "A minimal safety interlock: Motor = (NOT EmergencyStop) AND StartButton. The motor runs only while Start is held and E-stop is clear; both conditions are re-checked every 10 ms scan. The logical names here are bound to real terminals in an .iomap on hardware — see io/pico-interlock and io/opta-interlock for this same graph running on a board."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n3",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "n3",
        "port": "out"
      },
      "to": {
        "node": "n4",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "n2",
        "port": "value"
      },
      "to": {
        "node": "n4",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "n4",
        "port": "out"
      },
      "to": {
        "node": "n5",
        "port": "value"
      }
    }
  ],
  "hardware": [
    {
      "logical": "EmergencyStop",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "StartButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Motor",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 40,
        "y": 300
      },
      "n1": {
        "x": 40,
        "y": 40
      },
      "n2": {
        "x": 40,
        "y": 160
      },
      "n3": {
        "x": 240,
        "y": 40
      },
      "n4": {
        "x": 430,
        "y": 100
      },
      "n5": {
        "x": 620,
        "y": 100
      }
    }
  }
}
