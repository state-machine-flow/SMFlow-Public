{
  "formatVersion": 5,
  "name": "variable-compare",
  "targets": [
    "simulator"
  ],
  "tasks": [
    {
      "name": "main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "variable-read",
      "name": "in1",
      "comment": "Reads the shared variable 'in1' once at the top of the scan. The one output is wired to three compares below; that is fan-out of a single read, not three separate reads."
    },
    {
      "id": "n2",
      "type": "variable-read",
      "name": "in2"
    },
    {
      "id": "n3",
      "type": "compare",
      "comment": "compare is a single node type with an 'operator' property, not six different nodes. With no operator set it uses the default, '<', so this one emits in1 < in2. n4 is '==' and n5 is '>'."
    },
    {
      "id": "n4",
      "type": "compare",
      "properties": {
        "operator": "=="
      }
    },
    {
      "id": "n5",
      "type": "compare",
      "properties": {
        "operator": "\u003E"
      }
    },
    {
      "id": "n6",
      "type": "variable-write",
      "name": "comp1"
    },
    {
      "id": "n7",
      "type": "variable-write",
      "name": "comp2"
    },
    {
      "id": "n8",
      "type": "variable-write",
      "name": "comp3"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "What this shows",
      "comment": "Shared variables used as the data medium. in1 and in2 (float32) are read, compared three ways (<, ==, >), and the three boolean results are written back to comp1/comp2/comp3. variable-read/variable-write are how a graph touches named state declared in the 'variables' section, with an initial value and no pin behind it. Every scan recomputes all three results from the current values."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n3",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "n1",
        "port": "value"
      },
      "to": {
        "node": "n4",
