{
  "formatVersion": 4,
  "name": "not-gate",
  "tasks": [
    {
      "name": "Main",
      "periodMs": 10
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "digital-input",
      "name": "StartButton"
    },
    {
      "id": "not1",
      "type": "not"
    },
    {
      "id": "motor",
      "type": "digital-output",
      "name": "Motor"
    },
    {
      "id": "doc_overview",
      "type": "comment",
      "name": "How this runs",
      "comment": "Main runs every 10 ms (periodMs). There is no main loop to write and nothing to poll: each period the whole graph is re-evaluated once, in dataflow order, then the outputs are driven. So this program means Motor = !StartButton, recomputed 100 times a second. That periodic, run-to-completion scan is the SMFlow execution model."
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "value"
      },
      "to": {
        "node": "not1",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "not1",
        "port": "out"
      },
      "to": {
        "node": "motor",
        "port": "value"
      }
    }
  ],
  "hardware": [
    {
      "logical": "StartButton",
      "direction": "input",
      "type": "bool"
    },
    {
      "logical": "Motor",
      "direction": "output",
      "type": "bool"
    }
  ],
  "ui": {
    "nodes": {
      "doc_overview": {
        "x": 100,
        "y": 260
      },
      "motor": {
        "x": 500,
        "y": 100
      },
      "not1": {
        "x": 300,
        "y": 100
      },
      "start": {
        "x": 100,
        "y": 100
      }
    }
  }
}
