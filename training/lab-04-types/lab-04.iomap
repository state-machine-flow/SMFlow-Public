{
  "formatVersion": 1,
  "project": "Lab 04 - Types and Ports",
  "bindings": {
    "linux-x64": {
      "TankLevel": "analog0",
      "ReportEnable": "gpio0",
      "HighAlarm": "gpio1"
    },
    "simulator": {
      "TankLevel": "virtual.TankLevel",
      "ReportEnable": "virtual.ReportEnable",
      "HighAlarm": "virtual.HighAlarm"
    }
  },
  "serial": {
    "linux-x64": {
      "Console": {
        "bus": "console",
        "baud": 115200,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    },
    "simulator": {
      "Console": {
        "bus": "virtual.uart0",
        "baud": 9600,
        "txCapacity": 64,
        "txBufferOctets": 64
      }
    }
  }
}